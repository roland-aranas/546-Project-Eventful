<div id="calendar"></div>

<script>
  const savedEvents = {{{json savedEvents}}};
  const conflictingEvents = {{{json conflicts}}};
  if(conflictingEvents && conflictingEvents.length > 0) {
    alert('Warning: You have events in your calendar that may have time conflicts:\n' + conflictingEvents.map(e => e.title).join('\n'));
    const conflictMessage = document.createElement('p');
    conflictMessage.textContent = 'Warning: You have events in your calendar that may have time conflicts:\n' + conflictingEvents.map(e => e.title).join(', ');
    conflictMessage.style.color = 'red';
    document.body.insertBefore(conflictMessage, document.getElementById('calendar'));
  }

  document.addEventListener('DOMContentLoaded', function() {
    const calendarEl = document.getElementById('calendar');
    const calendar = new FullCalendar.Calendar(calendarEl, {
      initialView: 'dayGridMonth',
      events: savedEvents.map(e => ({
        title: e.title,
        start: e.startDate,
        end: e.endDate,
        url: '/events/' + e._id
      }))
    });
    calendar.render();
  });
</script>