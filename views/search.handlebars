<form method="GET" action="/events/search">
  <input type="text" name="q" placeholder="type..." value="{{query}}">

  <select name="borough">
    <option value="">All</option>
    <option value="Manhattan">Manhattan</option>
    <option value="Brooklyn">Brooklyn</option>
    <option value="Staten Island">Brooklyn</option>
    <option value="Queens">Brooklyn</option>
    <option value="The Bronx">Brooklyn</option>
  </select>

  <select name="eventType">
    <option value="">All</option>
    <option value="Music">Art</option>
    <option value="Sports">Sports</option>
  </select>

  <select name="sortBy">
    <option value="startDate">Date</option>
    <option value="cost">Cost</option>
    <option value="likeCount">Likes</option>
  </select>

  <select name="order">
    <option value="asc">Asc</option>
    <option value="desc">Desc</option>
  </select>

  <button type="submit">Submit</button>
</form>

<hr>

{{#if results}}
  {{#each results}}
      <a href="/events/{{this._id}}" class="event-card">
        <img src="{{this.image}}" alt="{{this.title}}">
        <h3>{{this.title}}</h3>
        <p class="description">{{this.description}}</p>
        <p class="startTime">Starts: {{this.startTime}}</p>
        <p class="endTime">Ends: {{this.endTime}}</p>
      </a>
        {{#if this.isSaved}}
          <form method="POST" action="/events/{{this._id}}/unsave">
          <button type="submit">Remove from Calendar</button>
          </form>
        {{else}}
          <form method="POST" action="/events/{{this._id}}/save">
          <button type="submit">Save to Calendar</button>
          </form>
        {{/if}}
  {{/each}}
{{else}}
  <p>No results</p>
{{/if}}