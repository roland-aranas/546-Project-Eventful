<!-- parameters needed:
recEvents (events happening in borough + today)
nextEvent (next event that user has saved) 
user (current user)
-->

<section class="hero">
    <h1>Name of App lol</h1>
    <h3>Welcome {{user.firstName}}!</h3>
</section>

<section class="next_event">
  <h3>Your Next Event: </h3>
  {{#if nextEvent.length}}
    <a href="/events/{{nextEvent._id}}" class="event-card">
      <img src="{{nextEvent.image}}" alt="{{nextEvent.title}}">
      <h3>{{nextEvent.title}}</h3>
      <p class="description">{{nextEvent.description}}</p>
      <p class="startTime">Starts: {{nextEvent.startTime}}</p>
      <p class="endTime">Ends: {{nextEvent.endTime}}</p>
  </a>
  {{else}}
  <p>No Events Planned</p>
  {{/if}}
</section>

<section class="recommended">
    <h2>Events Today in {{user.borough}}</h2>

  {{#if recEvents.length}}
    {{#each recEvents}}
      <a href="/events/{{this._id}}" class="event-card">
        <img src="{{this.image}}" alt="{{this.title}}">
        <h3>{{this.title}}</h3>
        <p class="description">{{this.description}}</p>
        <p class="startTime">Starts: {{this.startTime}}</p>
        <p class="endTime">Ends: {{this.endTime}}</p>
      </a>
    {{/each}}
  {{else}}
    <p>No events near you today.</p>
  {{/if}}
</section>