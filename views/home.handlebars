<!-- parameters needed:
recEvents (events happening in borough + today)
nextEvent (next event that user has saved) 
user (current user)
-->

<main class="container">
  <section class="hero card hero-card">
    <h1>Park Party</h1>
    {{#if user}}
      <h3>Welcome {{user.firstName}}!</h3>
    {{else}}
      <h3>Welcome to Park Party!</h3>
    {{/if}}
  </section>

{{#if weather}}
<section class="card weather card">
  <h3>Today's Weather in {{selectedBorough}}</h3>
  <p>{{weather.temperature_2m}}°F</p>
  <p>Precipitation: {{weather.precipitation}}"</p>
</section>
{{/if}}

{{#if user}}
  <section class="next_event card">
    <h3>Your Next Event: </h3>
    {{#if nextEvent}}
      <a href="/events/{{nextEvent._id}}" class="event-card">
        <img src="{{nextEvent.image}}" alt="{{nextEvent.title}}">
        <h3>{{nextEvent.title}}</h3>
        <p class="description">{{nextEvent.description}}</p>
        <p class="startTime">Starts: {{nextEvent.startTime}}</p>
        <p class="endTime">Ends: {{nextEvent.endTime}}</p>
        {{#if hasCheckedIn}}
          <p>You have checked in to this event.</p>
        {{else}}
          <form method="POST" action="/events/{{nextEvent._id}}/checkin">
            <button type="submit">Check In</button>
          </form>
        {{/if}}
    </a>
    {{else}}
    <p>No Events Planned Today!</p>
    {{/if}}
  </section>
  {{/if}}

  <section class="recommended card">
{{#if user}}
      <h2>Events Today in {{user.borough}}</h2>
{{else}}
      <h2>Events Today in: </h2>
      <form method="GET" action="/events/home">
    <select name="borough">
      <option value="Manhattan" {{#if (eq selectedBorough 'Manhattan')}}selected{{/if}}>Manhattan</option>
      <option value="Brooklyn" {{#if (eq selectedBorough 'Brooklyn')}}selected{{/if}}>Brooklyn</option>
      <option value="Queens" {{#if (eq selectedBorough 'Queens')}}selected{{/if}}>Queens</option>
      <option value="Bronx" {{#if (eq selectedBorough 'Bronx')}}selected{{/if}}>Bronx</option>
      <option value="Staten Island" {{#if (eq selectedBorough 'Staten Island')}}selected{{/if}}>Staten Island</option>
    </select>
    <button type="submit">Go</button>
  </form>
{{/if}}
    {{#if todayByBorough.length}}
      {{#each todayByBorough}}
        <a href="/events/{{this._id}}" class="event-card">
          <img src="{{this.image}}" alt="{{this.title}}">
          <h3>{{this.title}}</h3>
          <p class="description">{{this.description}}</p>
          <p class="startTime">Starts: {{this.startTime}}</p>
          <p class="endTime">Ends: {{this.endTime}}</p>
        </a>
      {{/each}}
    {{else}}
      <p>No events near you today.</p>
    {{/if}}
  </section>
  <section class="review-events card">
    <h2>Review Events</h2>
    <p>Review events you've attended to help other users find great events!</p>

    {{#if reviewQueue.length}}
      {{#each reviewQueue}}
        <div class="review-event-card">
          {{#if this.image}}
            <img src="{{this.image}}" alt="{{this.title}}">
          {{/if}}

          <div class="event-card-body">
            <a href="/events/{{this._id}}" class="review-event-title">
              <h3>{{this.title}}</h3>
            </a>

            <p class="description">{{this.description}}</p>
            <p class="startTime">Starts: {{this.startTime}}</p>
            <p class="endTime">Ends: {{this.endTime}}</p>

            <a href="/events/{{this._id}}/reviews" class="review-link">Write a Review</a>
          </div>
        </div>
      {{/each}}
    {{else}}
      <p>No events to review at the moment.</p>
    {{/if}}
  </section>
</main>